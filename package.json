{
  "name": "loxa-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": { "node": ">=22.13 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "tsx scripts/check-links.ts",
    "check:static": "node scripts/check-static-export.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:links && pnpm build && pnpm check:static"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "fumadocs-core": "16.11.2",
    "fumadocs-mdx": "15.1.0",
    "fumadocs-ui": "16.11.2",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.6.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "next-validate-link": "1.6.6",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
